datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Deal {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  title       String
  category    String
  askingPrice Float
  condition   String?

  // Full DealRecommendation returned by analyzeDeal().
  recommendation Json

  source         String  @default("manual")
  rawListingText String?

  // Set only when the owner explicitly shares the report. Null means the
  // deal is reachable through the authenticated routes and nowhere else.
  shareId String? @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Monetization
  plan               String   @default("free")
  monthlyUsage       Int      @default(0)
  monthlyAllowance   Int      @default(2)
  monthlyResetAt     DateTime
  creditBalance      Int      @default(0)
  subscriptionStatus String   @default("inactive")

  // Stripe information will be filled in during the next phase.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  deals        Deal[]
  transactions CreditTransaction[]
}

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  createdAt DateTime @default(now())

  stripeSessionId String? @unique

  @@index([userId])
  @@index([createdAt])
}